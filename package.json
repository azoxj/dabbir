{
  "name": "dabbir",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "دبّر — مساعد الحياة اليومية (PWA)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rls": "bash supabase/tests/run-rls-tests.sh",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "supabase:start": "node scripts/supabase-local.mjs start",
    "supabase:stop": "node scripts/supabase-local.mjs stop",
    "supabase:reset": "node scripts/supabase-local.mjs reset",
    "dev:local": "node scripts/with-local-env.mjs vite",
    "build:local": "node scripts/with-local-env.mjs vite build --outDir dist-supabase",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:e2e:supabase": "node tests/e2e/supabase-flow.mjs",
    "check:env": "node scripts/check-public-env.mjs",
    "test:rls:remote": "node scripts/supabase-remote-test.mjs",
    "build:demo": "node scripts/build-demo.mjs",
    "test:live": "node scripts/live-public-check.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "clsx": "^2.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "bcryptjs": "^2.4.3",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "playwright": "^1.63.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.5"
  }
}
