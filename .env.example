# انسخ هذا الملف إلى .env.local وضع قيم مشروع Supabase (بيئة تطوير/اختبار فقط).
# المسموح هنا: Project URL والمفتاح العام فقط (Publishable key أو anon key).
# ممنوع منعًا باتًا: service_role key أو أي مفتاح يبدأ بـ sb_secret_
# أي متغير يبدأ بـ VITE_ يُضمَّن في ملفات الواجهة ويراه أي مستخدم.
# اترك القيم فارغة لتشغيل «الوضع التجريبي» ببيانات محلية في المتصفح.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# المسار الأساسي للنشر (اختياري). الافتراضي /dabbir/ لـ https://azoxj.github.io/dabbir/
# استخدم / إذا نشرت على نطاق خاص أو مستودع azoxj.github.io
VITE_BASE=
